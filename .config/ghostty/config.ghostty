# ============================================================
# Ghostty config — convertido a partir do kitty.conf
# Coloque em: ~/.config/ghostty/config
# ============================================================

# --- Transparência / blur ---
background-opacity = 0.7
background-blur = true
# No X11/i3 o blur só funciona se o compositor (ex: picom) suportar
# blur de janela transparente; no Wayland/Hyprland funciona nativo.

# --- Fonte ---
font-family = Hack Nerd Font
font-size = 12
# Ghostty escolhe automaticamente as variantes bold/italic da família,
# não existe equivalente direto a "bold_font auto" etc.

# --- Cursor ---
cursor-style = block
cursor-style-blink = true
# Ghostty não tem controle fino de intervalo de piscar, thickness do
# beam/underline, "stop blinking after" ou cursor trail como no kitty.

# --- Scrollback ---
scrollback-limit = 2000
# Atenção: no Ghostty esse valor é em bytes, não em linhas como no
# kitty. 2000 é só um valor de partida — ajuste se sentir pouco.

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = false

# --- Janela ---
confirm-close-surface = false
window-padding-x = 4
window-padding-y = 4
# Sem equivalente direto para window_border_width, placement_strategy,
# window_resize_step_* e single_window_margin_width.

# --- Bell ---
# audio bell já vem desativado por padrão no Ghostty (sem opção
# enable_audio_bell); não há "visual_bell_duration" configurável.

# ============================================================
# Cores
# ============================================================

background = #181818
foreground = #ffffff

selection-background = #ffffff
selection-foreground = #181818

cursor-color = #ffffff
cursor-text  = #000000

# Paleta ANSI (0-15) — mesma paleta monocromática do kitty.conf
palette = 0=#282828
palette = 8=#3c3c3c

palette = 1=#a35b5b
palette = 9=#c17d7d

palette = 2=#7f9f7f
palette = 10=#a0c0a0

palette = 3=#bfa97a
palette = 11=#d9c497

palette = 4=#6f8fae
palette = 12=#8fb0d0

palette = 5=#9f7fac
palette = 13=#bfa0cc

palette = 6=#7aa3a3
palette = 14=#99c2c2

palette = 7=#d0d0d0
palette = 15=#f0f0f0

# ============================================================
# Sem equivalente no Ghostty (recursos exclusivos do kitty):
#   - tab_bar_style powerline / tab_separator / tab_title_template
#   - url_style / url_color (Ghostty sublinha URL mas não customiza cor)
#   - mark1/mark2/mark3 (marcas de texto)
#   - active_border_color / inactive_border_color / bell_border_color
#   - repaint_delay / input_delay / sync_to_monitor
#   - progress_bar top
# ============================================================
